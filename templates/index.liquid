{% comment %}
  The index template is used for the home page of the store.
  This template showcases the reveal image functionality with 3D effects and video banner.
{% endcomment %}

<!-- Hero Reveal Image Section -->
<section class="hero-section section--large">
  <div class="container">
    <div class="hero-content text-center">
      <h1 class="hero-title">Revolutionary Reveal Image Experience</h1>
      <p class="hero-subtitle">Discover hidden content with stunning 3D effects and interactive video banners</p>
      <a href="#main-reveal" class="button button--large">Explore Now</a>
    </div>
  </div>
</section>

<!-- Main Reveal Image Section -->
{% section 'reveal-image' %}

<!-- Additional Demo Sections -->
<section class="demo-section section" id="demo-gallery">
  <div class="container">
    <div class="section-header text-center">
      <h2>Interactive Gallery Demos</h2>
      <p>Experience different reveal animations and 3D effects</p>
    </div>
    
    <div class="demo-grid">
      <!-- Flip Animation Demo -->
      <div class="reveal-image-container" 
           data-animation="flip"
           data-speed="800"
           data-enable-3d="true"
           role="button"
           tabindex="0"
           aria-label="3D Flip reveal demo">
        <div class="reveal-card">
          <div class="reveal-image-front">
            <div class="demo-placeholder flip-front">
              <h3>3D Flip</h3>
              <p>Click to flip</p>
            </div>
            <div class="reveal-overlay">
              <div class="reveal-overlay-content">
                <h3>3D Flip Effect</h3>
                <p>Experience the smooth 3D flip animation</p>
                <button class="button">Flip Card</button>
              </div>
            </div>
          </div>
          <div class="reveal-image-back">
            <div class="demo-placeholder flip-back">
              <h3>Flipped!</h3>
              <p>Amazing 3D effect</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Slide Animation Demo -->
      <div class="reveal-image-container" 
           data-animation="slide"
           data-speed="600"
           data-enable-3d="true"
           role="button"
           tabindex="0"
           aria-label="Slide reveal demo">
        <div class="reveal-image-front">
          <div class="demo-placeholder slide-front">
            <h3>Slide Effect</h3>
            <p>Click to slide</p>
          </div>
          <div class="reveal-overlay">
            <div class="reveal-overlay-content">
              <h3>Slide Animation</h3>
              <p>Smooth sliding transition</p>
              <button class="button">Slide Open</button>
            </div>
          </div>
        </div>
        <div class="reveal-image-back">
          <div class="demo-placeholder slide-back">
            <h3>Revealed!</h3>
            <p>Sliding animation complete</p>
          </div>
        </div>
      </div>

      <!-- Fade Animation Demo -->
      <div class="reveal-image-container" 
           data-animation="fade"
           data-speed="1000"
           data-enable-3d="true"
           role="button"
           tabindex="0"
           aria-label="Fade reveal demo">
        <div class="reveal-image-front">
          <div class="demo-placeholder fade-front">
            <h3>Fade Effect</h3>
            <p>Click to fade</p>
          </div>
          <div class="reveal-overlay">
            <div class="reveal-overlay-content">
              <h3>Fade Transition</h3>
              <p>Elegant fade animation</p>
              <button class="button">Fade In</button>
            </div>
          </div>
        </div>
        <div class="reveal-image-back">
          <div class="demo-placeholder fade-back">
            <h3>Faded In!</h3>
            <p>Beautiful fade effect</p>
          </div>
        </div>
      </div>

      <!-- Zoom Animation Demo -->
      <div class="reveal-image-container" 
           data-animation="zoom"
           data-speed="700"
           data-enable-3d="true"
           role="button"
           tabindex="0"
           aria-label="Zoom reveal demo">
        <div class="reveal-image-front">
          <div class="demo-placeholder zoom-front">
            <h3>Zoom Effect</h3>
            <p>Click to zoom</p>
          </div>
          <div class="reveal-overlay">
            <div class="reveal-overlay-content">
              <h3>Zoom Animation</h3>
              <p>Dynamic zoom transition</p>
              <button class="button">Zoom In</button>
            </div>
          </div>
        </div>
        <div class="reveal-image-back">
          <div class="demo-placeholder zoom-back">
            <h3>Zoomed!</h3>
            <p>Powerful zoom effect</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Video Banner Demo Section -->
<section class="video-demo-section section">
  <div class="container">
    <div class="section-header text-center">
      <h2>Video Banner Integration</h2>
      <p>See how video banners work alongside reveal images</p>
    </div>
    
    <div class="video-demo-grid">
      <div class="video-banner-container">
        <!-- Demo video banner with placeholder -->
        <div class="demo-video-placeholder">
          <div class="demo-video-content">
            <div class="video-icon">
              <svg width="80" height="80" viewBox="0 0 24 24" fill="white">
                <circle cx="12" cy="12" r="10"/>
                <polygon points="10,8 16,12 10,16" fill="#000"/>
              </svg>
            </div>
            <h3>Video Banner</h3>
            <p>Interactive video content</p>
          </div>
        </div>
        <div class="video-banner-overlay">
          <button class="video-play-button" aria-label="Play demo video"></button>
        </div>
      </div>
      
      <div class="reveal-image-container" 
           data-animation="flip"
           data-speed="800"
           data-enable-3d="true"
           role="button"
           tabindex="0"
           aria-label="Product reveal demo">
        <div class="reveal-card">
          <div class="reveal-image-front">
            <div class="demo-placeholder product-front">
              <h3>Product View</h3>
              <p>See details</p>
            </div>
            <div class="reveal-overlay">
              <div class="reveal-overlay-content">
                <h3>Product Gallery</h3>
                <p>Click to see product details</p>
                <button class="button">View Product</button>
              </div>
            </div>
          </div>
          <div class="reveal-image-back">
            <div class="demo-placeholder product-back">
              <h3>Product Info</h3>
              <p>Price: $99.99</p>
              <button class="button button--secondary">Add to Cart</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: var(--color-secondary);
    text-align: center;
  }

  .hero-title {
    font-size: 4rem;
    margin-bottom: 1rem;
    font-weight: bold;
  }

  .hero-subtitle {
    font-size: 1.8rem;
    margin-bottom: 3rem;
    opacity: 0.9;
  }

  .button--large {
    padding: 1.5rem 3rem;
    font-size: 1.6rem;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    margin-top: 3rem;
  }

  .video-demo-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 3rem;
  }

  .demo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    border-radius: 1rem;
    padding: 2rem;
    min-height: 300px;
  }

  .flip-front { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
  .flip-back { background: linear-gradient(135deg, #f093fb, #f5576c); color: white; }
  .slide-front { background: linear-gradient(135deg, #4facfe, #00f2fe); color: white; }
  .slide-back { background: linear-gradient(135deg, #43e97b, #38f9d7); color: white; }
  .fade-front { background: linear-gradient(135deg, #fa709a, #fee140); color: white; }
  .fade-back { background: linear-gradient(135deg, #a8edea, #fed6e3); color: #333; }
  .zoom-front { background: linear-gradient(135deg, #d299c2, #fef9d7); color: #333; }
  .zoom-back { background: linear-gradient(135deg, #89f7fe, #66a6ff); color: white; }
  .product-front { background: linear-gradient(135deg, #667eea, #764ba2); color: white; }
  .product-back { background: linear-gradient(135deg, #f093fb, #f5576c); color: white; }

  .demo-video-placeholder {
    width: 100%;
    height: 300px;
    background: linear-gradient(135deg, #2c3e50, #3498db);
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    position: relative;
  }

  .demo-video-content {
    text-align: center;
  }

  .video-icon {
    margin-bottom: 1rem;
  }

  .text-center {
    text-align: center;
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header h2 {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .section-header p {
    font-size: 1.6rem;
    opacity: 0.8;
  }

  @media screen and (max-width: 768px) {
    .hero-title {
      font-size: 3rem;
    }
    
    .hero-subtitle {
      font-size: 1.4rem;
    }
    
    .demo-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .video-demo-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .demo-placeholder {
      min-height: 250px;
    }
  }
</style>